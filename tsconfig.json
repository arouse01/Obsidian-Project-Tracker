{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"lib": [ "ES2021", "DOM" ],
		//"noUnusedLocals": true,
		//"noUnusedParameters": true
		//"baseUrl": ".",
		"paths": {
			//"*": [ "./*" ],
			"@/*": ["./src/*"],
			//"@issues/*": [ "./issues/*" ],
			//"@notes/*": [ "./notes/*" ],
			//"@projects/*": [ "./projects/*" ],
			//"@utils/*": [ "./utils/*" ],
			//"@time/*": [ "./time/*" ],
			//"@todos/*": [ "./todos/*" ],
			
			"@issues/*": [ "./*" ],
			"@notes/*": [ "./*" ],
			"@projects/*": [ "./*" ],
			"@utils/*": [ "./src/*" ],
			"@time/*": [ "./*" ],
			"@todos/*": [ "./*" ]
		}
	},
	//"include": ["src/**/*.ts"]
}
